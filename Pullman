WITH pullman_merchants (merchant_id) AS (
    VALUES
        ('J7KC6JLFIJ'),
        ('M0ZCT4GSAT'),
        ('IX8YV49KVP'),
        ('45GXPINC22'),
        ('375N178LGP')
),

qr_transacciones_dedup AS (
    SELECT
        UPPER(TRIM(t.merchant_id)) AS merchant_id,
        t.transaction_id,
        MIN(d.date) AS fecha_transaccion,
        MAX(CAST(t.tpv AS DECIMAL(38,2))) AS tpv

    FROM bold_gold_finance.mart_tpv_daily_by_transaction AS t

    INNER JOIN bold_gold_core.dim_date AS d
        ON t.date_key = d.date_key

    INNER JOIN pullman_merchants AS p
        ON UPPER(TRIM(t.merchant_id)) = p.merchant_id

    WHERE UPPER(TRIM(t.plan_name)) = 'QR_BOLD'
      AND d.date BETWEEN DATE '2026-01-01' AND DATE '2026-08-11'

    GROUP BY
        UPPER(TRIM(t.merchant_id)),
        t.transaction_id
)

SELECT
    CAST(DATE_TRUNC('month', fecha_transaccion) AS DATE) AS mes,
    merchant_id,
    COUNT(*) AS numero_transacciones,
    CAST(SUM(tpv) AS DECIMAL(38,2)) AS tpv_total,
    CAST(AVG(tpv) AS DECIMAL(38,2)) AS ticket_promedio,
    MIN(fecha_transaccion) AS primera_transaccion_mes,
    MAX(fecha_transaccion) AS ultima_transaccion_mes

FROM qr_transacciones_dedup

GROUP BY
    CAST(DATE_TRUNC('month', fecha_transaccion) AS DATE),
    merchant_id

ORDER BY
    mes ASC,
    merchant_id ASC;
