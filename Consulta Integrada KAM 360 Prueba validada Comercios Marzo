        address_payments,
        city_code_payments,
        email_legal_representative,
        cellphone_legal_representative,
        manual_verification_status_code,
        merchant_status_code,
        sales_agent_email_payments,
        sales_reference,
        sales_source_payments_raw,
        sales_source_payments,
        onboarding_end_date_payments
    FROM payments_merchant_ranked
    WHERE rn = 1
),

